/* Widget types define dimensions; roles change colour without changing size. */
QWidget {
  background-color: #101820;
  color: #edf2f4;
  font-family: "Segoe UI";
  font-size: 14px;
}
QLabel { background: transparent; }
QLabel[role="title"], QLabel#titleLabel {
  font-size: 32px;
  font-weight: bold;
  color: white;
}
QLabel[role="subtitle"], QLabel#subtitleLabel {
  color: #9bb0b7;
  padding-bottom: 12px;
}
QLabel[role="field"], QLabel#form_label { color: #d9e2e5; font-weight: 600; }
QLabel[role="status"] { color: #f4a261; }

QPushButton {
  min-height: 24px;
  max-height: 24px;
  padding: 8px 16px;
  border: 2px solid #49616a;
  border-radius: 6px;
  background-color: #18262d;
  color: #edf2f4;
  font-size: 15px;
  outline: none;
}
QPushButton[controlSize="dashboard"] { min-height: 32px; max-height: 32px; }
QPushButton[role="primary"] { background-color: #2a9d8f; border-color: #2a9d8f; color: white; }
QPushButton[role="accent"] { background-color: #e76f51; border-color: #e76f51; color: white; }
QPushButton:hover { background-color: #29414b; }
QPushButton[role="primary"]:hover { background-color: #24877c; }
QPushButton[role="accent"]:hover { background-color: #cf5e42; }
QPushButton:pressed { background-color: #20353d; }
QPushButton:focus { border-color: #f4a261; }
QPushButton:disabled { background-color: #263b44; border-color: #263b44; color: #91a4ac; }

QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
  min-height: 24px;
  max-height: 24px;
  padding: 8px 10px;
  border: 2px solid #49616a;
  border-radius: 5px;
  background-color: #18262d;
  color: #edf2f4;
  selection-background-color: #2a9d8f;
  selection-color: white;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #2a9d8f; }
QLineEdit:read-only { color: #9bb0b7; }
QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled { color: #91a4ac; border-color: #334b54; }
QComboBox, QDateEdit { padding-right: 32px; }
QComboBox::drop-down, QDateEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 28px;
  border: none;
}
QComboBox::down-arrow, QDateEdit::down-arrow { image: url(:/icons/caret-down.xpm); width: 12px; height: 8px; }
QComboBox QAbstractItemView {
  background-color: #18262d;
  color: #edf2f4;
  border: 1px solid #49616a;
  selection-background-color: #2a9d8f;
  selection-color: white;
  padding: 4px;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 2px solid #49616a; border-radius: 3px; background-color: #18262d; }
QCheckBox::indicator:checked { background-color: #2a9d8f; border-color: #2a9d8f; image: url(:/icons/check.xpm); }
QCheckBox::indicator:focus { border-color: #f4a261; }

QMenuBar { background-color: #18262d; padding: 4px; }
QMenuBar::item { padding: 6px 12px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background-color: #2a9d8f; color: white; }
QMenu { background-color: #18262d; border: 1px solid #49616a; padding: 4px; }
QMenu::item { padding: 6px 24px; }
QGroupBox { border: 1px solid #334b54; border-radius: 6px; margin-top: 16px; padding: 16px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
